<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.calliope.songsmith</string>

  <!-- node running tsx's entry directly (NOT `npm start`, which doesn't
       reliably propagate kills and orphans old servers on :8765; NOT a
       shell wrapper, which macOS TCC blocks from user folders). launchd
       owns the real server process. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__SONGSMITH_DIR__/node_modules/tsx/dist/cli.mjs</string>
    <string>src/server.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__SONGSMITH_DIR__</string>

  <!-- launchd does not inherit a login shell's PATH; without the brew dirs,
       yt-dlp and ffmpeg silently vanish and every song errors at 'audio'. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__SONGSMITH_DIR__/logs/songsmith.log</string>
  <key>StandardErrorPath</key>
  <string>__SONGSMITH_DIR__/logs/songsmith.err.log</string>
</dict>
</plist>
